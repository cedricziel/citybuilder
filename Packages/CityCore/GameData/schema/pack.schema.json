{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack.schema.json",
  "title": "Game data pack",
  "description": "One feature's goods, buildings, cultures, techs, ages and house tiers. References may point into any pack.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "description": "Anchored mappings that items merge with <<. Ignored otherwise.",
      "type": "object"
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "positive": { "type": "integer", "minimum": 1 },
    "nonNegative": { "type": "integer", "minimum": 0 },
    "tier": { "description": "A house tier id declared by a Tier item.", "$ref": "#/$defs/id" },
    "amounts": {
      "description": "Amount per good id.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/positive" }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycleTicks"],
      "properties": {
        "inputs": { "$ref": "#/$defs/amounts" },
        "outputs": { "$ref": "#/$defs/amounts" },
        "cycleTicks": { "$ref": "#/$defs/positive" }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "shore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minLand", "minWater"],
          "properties": {
            "minLand": { "$ref": "#/$defs/positive" },
            "minWater": { "$ref": "#/$defs/positive" }
          }
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minTiles"],
          "properties": {
            "type": { "enum": ["grass", "forest", "beach", "water", "mountain"] },
            "minTiles": { "$ref": "#/$defs/positive" }
          }
        }
      }
    },
    "island": { "description": "home, or the rank of another island by size from 1.", "oneOf": [{ "const": "home" }, { "$ref": "#/$defs/positive" }] },
    "chapterStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money": { "$ref": "#/$defs/nonNegative" },
        "stock": { "$ref": "#/$defs/amounts" },
        "rivalAgeYears": { "description": "The earliest year a rival may enter each age on this difficulty.", "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "type": "integer" } }
      }
    },
    "chapterGoal": {
      "description": "Exactly one goal kind. residents takes an optional tier (default the first tier); stock, buildings and landed take a count. hold: true needs the condition for a whole season.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "residents": { "$ref": "#/$defs/positive" },
        "tier": { "$ref": "#/$defs/tier" },
        "age": { "$ref": "#/$defs/id" },
        "stock": { "$ref": "#/$defs/id" },
        "buildings": { "$ref": "#/$defs/id" },
        "landed": { "description": "Units unloaded by player ships at a home-island port.", "$ref": "#/$defs/id" },
        "count": { "$ref": "#/$defs/positive" },
        "research": { "$ref": "#/$defs/id" },
        "treasury": { "$ref": "#/$defs/positive" },
        "netIncome": { "description": "Tax minus upkeep over the last season.", "type": "integer" },
        "tradeEarnings": { "$ref": "#/$defs/positive" },
        "orders": { "$ref": "#/$defs/positive" },
        "signatureProjects": { "$ref": "#/$defs/positive" },
        "outgrowRivals": { "const": true },
        "hold": { "type": "boolean" }
      }
    },
    "item": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["Good", "Building", "Culture", "Tech", "Age", "Tier", "Order", "Event", "Campaign", "Chapter"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "Good" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "name", "unit", "basePrice"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "unit": { "description": "Plural stack noun, e.g. logs.", "type": "string" },
              "basePrice": { "$ref": "#/$defs/positive" },
              "market": {
                "description": "Seasonal town market limits: units the market sells to the player (buy) and buys from the player (sell). Each defaults to 0.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "buy": { "$ref": "#/$defs/nonNegative" },
                  "sell": { "$ref": "#/$defs/nonNegative" }
                }
              },
              "neededBy": {
                "description": "House tiers whose needs this good joins, after the tier's own needs, in load order.",
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/tier" }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Building" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "footprint", "cost"],
            "dependentRequired": { "plantTicks": ["catchmentRadius"] },
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "name": { "description": "Palette label. Defaults to the id, title-cased.", "type": "string" },
              "legacyIds": { "description": "Old ids that saves may still store.", "type": "array", "items": { "type": "string" } },
              "footprint": {
                "description": "[width, height] in tiles.",
                "type": "array",
                "items": { "$ref": "#/$defs/positive" },
                "minItems": 2,
                "maxItems": 2
              },
              "cost": { "$ref": "#/$defs/nonNegative" },
              "upkeep": { "$ref": "#/$defs/nonNegative" },
              "buildTicks": { "$ref": "#/$defs/positive" },
              "storage": { "description": "Stockpile capacity shared by every good. Omit for none.", "$ref": "#/$defs/positive" },
              "storagePerGood": { "description": "Units of each good a store holds; use instead of storage.", "$ref": "#/$defs/positive" },
              "plantTicks": { "description": "Ticks per forest tile planted; only planting buildings set it.", "$ref": "#/$defs/positive" },
              "catchmentRadius": { "description": "Tiles around the footprint (Chebyshev) a gathering or planting building works. Omit for none.", "$ref": "#/$defs/positive" },
              "category": { "description": "Build drawer. Omit for none.", "enum": ["town", "gather", "craft"] },
              "materials": { "$ref": "#/$defs/amounts" },
              "recipe": { "$ref": "#/$defs/recipe" },
              "unlockedBy": { "$ref": "#/$defs/id" },
              "obsoletedBy": { "$ref": "#/$defs/id" },
              "culture": { "description": "Only this culture may build it.", "$ref": "#/$defs/id" },
              "placement": { "$ref": "#/$defs/placement" },
              "effect": { "description": "The behaviour is written in Swift.", "const": "code" },
              "accepts": {
                "description": "The only goods a store takes; needs storagePerGood. Omit for every good.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "crop": { "description": "A crop field, which blight slows. Needs a recipe that grows a good.", "type": "boolean" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Culture" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "name", "blurb", "luxury", "signature", "residentNames"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string" },
              "blurb": { "type": "string" },
              "tiers": {
                "description": "The culture's name for house tiers, keyed by tier id. A tier left out uses its own name.",
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/tier" },
                "additionalProperties": { "type": "string" }
              },
              "luxury": {
                "type": "object",
                "additionalProperties": false,
                "required": ["raw", "good", "garden", "producer"],
                "properties": {
                  "raw": { "$ref": "#/$defs/id" },
                  "good": { "$ref": "#/$defs/id" },
                  "garden": { "$ref": "#/$defs/id" },
                  "producer": { "$ref": "#/$defs/id" }
                }
              },
              "signature": { "$ref": "#/$defs/id" },
              "residentNames": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Tech" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "cost", "age"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "name": { "description": "Defaults to the id, title-cased.", "type": "string" },
              "cost": { "description": "Knowledge.", "$ref": "#/$defs/positive" },
              "age": { "description": "The age from which it can be researched.", "$ref": "#/$defs/id" },
              "prerequisites": { "$ref": "#/$defs/ids" },
              "era": { "description": "The age this tech opens.", "$ref": "#/$defs/id" },
              "eraGate": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tier", "residents"],
                "properties": {
                  "tier": { "$ref": "#/$defs/tier" },
                  "residents": { "$ref": "#/$defs/positive" }
                }
              }
            },
            "dependentRequired": { "era": ["eraGate"], "eraGate": ["era"] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Age" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "startYear", "blurb", "signature", "rivalResidents"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "name": { "description": "Defaults to the id, title-cased.", "type": "string" },
              "startYear": { "description": "Astronomical year: -499 is 500 BC.", "type": "integer" },
              "blurb": { "type": "string" },
              "signature": { "$ref": "#/$defs/id" },
              "rivalResidents": { "description": "Residents a rival needs to enter this age.", "$ref": "#/$defs/nonNegative" },
              "orderEvery": { "description": "Seasons between crown orders in this age. Defaults to 4.", "type": "integer", "minimum": 1, "maximum": 12 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Event" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "effect", "seasons", "weight", "banners"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "effect": { "description": "The mechanic, written in Swift.", "enum": ["fire", "blight", "fever", "festival"] },
              "seasons": {
                "description": "Possible onset seasons. A fire, blight or fever never strikes in spring.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["spring", "summer", "autumn", "winter"] }
              },
              "minAge": { "description": "The first age the event can happen in. Defaults to the first age.", "$ref": "#/$defs/id" },
              "enabled": { "description": "False keeps the event out of every draw and schedule until its mechanic ships. Defaults to true.", "type": "boolean" },
              "weight": {
                "description": "Draw weight per difficulty.",
                "type": "object",
                "additionalProperties": false,
                "required": ["easy", "normal", "hard"],
                "properties": {
                  "easy": { "$ref": "#/$defs/nonNegative" },
                  "normal": { "$ref": "#/$defs/nonNegative" },
                  "hard": { "$ref": "#/$defs/nonNegative" }
                }
              },
              "banners": {
                "description": "Banner title and text by moment. Placeholders: {season}, {building}, {buildings}, {residents}, {date}, {deadline}, {bread}, {luxury}, {luxuryGood}, {bonus}.",
                "type": "object",
                "propertyNames": { "enum": ["warning", "onset", "ignition", "end", "endNoLoss", "endNoFire", "request", "held", "missed"] },
                "patternProperties": {
                  "": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "text"],
                    "properties": { "title": { "type": "string", "minLength": 1 }, "text": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Order" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "issuer", "good", "title", "text", "seasons", "size", "min", "max", "reward"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "issuer": { "description": "Who asks: the crown, or a rival town short of the good.", "enum": ["crown", "rival"] },
              "good": { "$ref": "#/$defs/id" },
              "title": { "description": "The card heading.", "type": "string", "minLength": 1 },
              "text": { "description": "One line of flavour.", "type": "string", "maxLength": 100 },
              "minAge": { "description": "The first age the order appears in. Defaults to the first age.", "$ref": "#/$defs/id" },
              "seasons": { "description": "Seasons from issue to the deadline, before difficulty scales it.", "type": "integer", "minimum": 1, "maximum": 8 },
              "size": { "description": "Percent of the town's recent output over the window that the order asks for.", "type": "integer", "minimum": 1, "maximum": 300 },
              "min": { "description": "Fewest units it asks for; below this the order is not issued.", "$ref": "#/$defs/positive" },
              "max": { "description": "Most units it asks for.", "$ref": "#/$defs/positive" },
              "reward": { "description": "Money paid, as a percent of the goods' base price.", "type": "integer", "minimum": 0, "maximum": 500 },
              "favour": { "description": "Favour gained on fulfilment. Defaults to 2.", "$ref": "#/$defs/nonNegative" },
              "penalty": { "description": "Favour lost on a miss. Defaults to 2.", "$ref": "#/$defs/nonNegative" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Tier" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "name", "capacity", "taxPerResident", "needs"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "name": { "description": "Default display name; a culture's tiers map can override it.", "type": "string" },
              "capacity": { "description": "Residents a house of this tier holds.", "$ref": "#/$defs/positive" },
              "taxPerResident": { "$ref": "#/$defs/nonNegative" },
              "needs": { "description": "Goods this tier needs, in consumption order.", "$ref": "#/$defs/ids", "uniqueItems": true },
              "declineGrace": { "description": "Consumption intervals a need may stay short before a house of this tier declines, on Normal. Defaults to 1.", "type": "integer", "minimum": 1, "maximum": 254 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Campaign" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "title", "chapters"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "chapters": { "description": "Chapter ids in play order.", "$ref": "#/$defs/ids", "minItems": 1 },
              "opensAfter": { "description": "The chapter whose win opens this campaign. Omit for one open from the start.", "$ref": "#/$defs/id" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Chapter" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "id", "title", "intro", "ending", "layout", "seed", "age", "money", "goals", "reward"],
            "properties": {
              "kind": true,
              "id": { "$ref": "#/$defs/id" },
              "title": { "type": "string", "minLength": 1 },
              "intro": { "description": "The intro card text.", "type": "string", "minLength": 1, "maxLength": 320 },
              "ending": { "description": "The ending card text.", "type": "string", "minLength": 1, "maxLength": 320 },
              "layout": { "enum": ["single-island", "archipelago"] },
              "seed": { "$ref": "#/$defs/nonNegative" },
              "age": { "$ref": "#/$defs/id" },
              "culture": { "description": "A fixed culture. Omit to let the player choose.", "$ref": "#/$defs/id" },
              "rivals": { "description": "Rival towns on the archipelago; there are three rival cultures.", "type": "integer", "minimum": 0, "maximum": 3 },
              "money": { "description": "Normal starting money: Easy ×1.5 and Hard ×0.7, rounded to $50.", "$ref": "#/$defs/nonNegative" },
              "stock": { "description": "Normal starting stock per town center: Easy ×1.5 and Hard ×0.5, rounded up.", "$ref": "#/$defs/amounts" },
              "overrides": {
                "description": "Money, stock or rival age years for one difficulty, in place of the chapter's.",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "easy": { "$ref": "#/$defs/chapterStart" },
                  "normal": { "$ref": "#/$defs/chapterStart" },
                  "hard": { "$ref": "#/$defs/chapterStart" }
                }
              },
              "directives": {
                "description": "Terrain changes after generation, in order.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "maxProperties": 1,
                  "properties": {
                    "thinForest": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["island", "keep"],
                      "properties": { "island": { "$ref": "#/$defs/island" }, "keep": { "type": "integer", "minimum": 0, "maximum": 100 } }
                    },
                    "pushMineOut": { "description": "Radius around the home town center, beyond its start area.", "type": "integer", "minimum": 8 },
                    "noMountains": { "$ref": "#/$defs/island" },
                    "raiseMineSite": { "$ref": "#/$defs/island" }
                  }
                }
              },
              "closedBuildings": { "$ref": "#/$defs/ids" },
              "closedTechs": { "$ref": "#/$defs/ids" },
              "researched": { "description": "Techs done at the start, besides the age's own.", "$ref": "#/$defs/ids" },
              "goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/chapterGoal" } },
              "bonus": { "description": "Bonus goals: each one met on a win is a laurel.", "type": "array", "items": { "$ref": "#/$defs/chapterGoal" } },
              "lose": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "deadline": { "description": "The year whose first tick loses the chapter. Easy adds a third of the span.", "type": "integer" },
                  "rivalRace": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": { "age": { "$ref": "#/$defs/id" }, "residents": { "$ref": "#/$defs/positive" }, "tier": { "$ref": "#/$defs/tier" } }
                  },
                  "collapse": { "description": "A residents floor, armed once reached.", "$ref": "#/$defs/positive" }
                }
              },
              "rivalAgeYears": {
                "description": "The earliest year a rival may enter each age.",
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/id" },
                "additionalProperties": { "type": "integer" }
              },
              "difficulties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["easy", "normal", "hard"] } },
              "reward": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "maxProperties": 1,
                "properties": { "banner": { "type": "string" }, "decor": { "type": "string" }, "mapPreset": { "type": "string" } }
              },
              "sweep": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "firstSteps": { "type": "boolean" },
                  "order": { "enum": ["careful", "naive"] },
                  "market": { "type": "boolean" },
                  "kits": { "type": "array", "items": { "type": "string" } }
                }
              },
              "comingLater": { "description": "Shown but never opened.", "type": "boolean" },
              "events": {
                "description": "Seasonal events by year: at most one a year, no hazard in spring.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["year", "season", "event"],
                  "properties": {
                    "year": { "type": "integer" },
                    "season": { "enum": ["spring", "summer", "autumn", "winter"] },
                    "event": { "$ref": "#/$defs/id" }
                  }
                }
              },
              "randomEvents": { "description": "False turns off the random draw. Defaults to true.", "type": "boolean" }
            }
          }
        }
      ]
    }
  }
}
