    "banner.bankrupt.text" : {
      "comment" : "Game-over banner text.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stadtkasse war zu lange im Minus, die Stadt ist verloren. Du kannst noch im Pausemenü speichern oder zum Hauptmenü gehen, um einen Spielstand zu laden oder neu zu beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The treasury stayed in the red too long and the town is lost. You can still save from the pause menu, or quit to the title to load a save or start a new game."
          }
        }
      }
    },
