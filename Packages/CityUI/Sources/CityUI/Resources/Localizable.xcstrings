    "banner.deficit.text" : {
      "comment" : "Deficit hint.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einwohner zahlen nur Steuern, wenn sie satt sind. Baue einen Hof, füll deine Häuser und verkaufe Überschuss am Markt des Rathauses."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Residents pay tax only when fed. Build a farm, fill your houses, and sell surplus at the town center's market."
          }
        }
      }
    },
