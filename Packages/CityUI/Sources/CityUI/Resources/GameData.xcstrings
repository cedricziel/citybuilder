    "seasonalEvent.fire.banner.warning.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächste Jahreszeit ist die Brandgefahr hoch. Eine Feuerwache löscht Brände im Umkreis von 8 Feldern, die ihre Straßen erreichen, und eine Straße zwischen Gebäuden hält die Flammen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fire risk is high next season. A fire watch puts out fires within 8 tiles that its roads reach, and a road between buildings stops the flames."
          }
        }
      }
    },
