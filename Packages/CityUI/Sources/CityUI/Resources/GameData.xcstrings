    "seasonalEvent.festival.banner.request.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liefere bis {deadline}: {bread} Brot und {luxury} {luxuryGood}. Nimm beides auf der Auftragstafel an. Häuser nahe dem Markt steigen dann ein Jahr lang schneller auf und zahlen mehr Steuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deliver {bread} bread and {luxury} {luxuryGood} by {deadline}. Accept both on the order board. Houses near the market then advance faster and pay more tax for a year."
          }
        }
      }
    },
