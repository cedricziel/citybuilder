      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächste Jahreszeit kann es das markierte Viertel erreichen. Ein Medicus mit Kräutern schützt Häuser im Umkreis von 8 Feldern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next season it may reach the marked district. A physician with herbs keeps houses within 8 tiles safe."
          }
        }
      }
    },
