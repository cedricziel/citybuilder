    "seasonalEvent.fever.banner.onset.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Häuser im markierten Viertel steigen nicht auf, und einige Einwohner ziehen fort, bis {date}."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houses in the marked district can't advance, and some residents leave, until {date}."
