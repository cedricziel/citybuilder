    "seasonalEvent.fire.banner.ignition.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brand: {building}. Ohne Feuerwache in Reichweite springt das Feuer auf angrenzende Gebäude über, und sie brennen zu Ruinen nieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {building} is burning. Without a fire watch in reach, it spreads to touching buildings and burns down to ruins."
          }
        }
      }
    },
    "seasonalEvent.fire.banner.ignition.title" : {
