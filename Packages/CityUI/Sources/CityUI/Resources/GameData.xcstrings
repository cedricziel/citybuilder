    },
    "seasonalEvent.fire.banner.ignitionCovered.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brand: {building}. Eine Feuerwache in Reichweite schickt ihren Wächter zum Löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A {building} is burning. A fire watch in reach sends its watchman to put it out."
