      }
    },
    "seasonalEvent.festival.banner.held.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
