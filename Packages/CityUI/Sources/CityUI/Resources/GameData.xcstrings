    "seasonalEvent.blight.banner.warning.text" : {
      "comment" : "A seasonal event's banner. {names} are filled in after the lookup.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächste Jahreszeit tragen Felder im markierten Gebiet nur die Hälfte. Fülle einen Kornspeicher oder kaufe Nahrung am Markt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next season, fields in the marked area yield half. Fill a granary, or buy food at the market."
          }
        }
      }
    },
