# Generated by XcodeGen
*.xcodeproj
*.xcworkspace
Apps/**/Info.plist
Apps/**/*.entitlements

# Swift / Xcode build artifacts
.build/
.swiftpm/
DerivedData/
Packages/*/.build/
Packages/*/.swiftpm/
*.xcuserdatad/
xcuserdata/
*.xcuserstate

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp
*.swo

# Coverage / profiling
*.profraw
*.profdata
coverage/*.lcov
coverage/*.json

# pre-commit
.pre-commit-cache/

# Audio audition candidates — never ship, never commit
Resources/Audio/_candidates/

# Local scratch / experiment workspace
.scratch/

# Claude Code ephemeral worktrees (skills + commands stay tracked)
.claude/worktrees/

# Python venv + cache for the AI sprite pipeline
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Sprite pipeline local cache (committed sheets live in _sheets/)
Resources/Sprites.style/_cache/
